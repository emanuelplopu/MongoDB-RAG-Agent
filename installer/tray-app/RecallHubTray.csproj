<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
    <AssemblyName>RecallHubTray</AssemblyName>
    <RootNamespace>RecallHub.TrayApp</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>RecallHub</Authors>
    <Description>RecallHub Desktop Application</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- WebView2Loader.dll must travel inside the single exe: INSTALL.ps1 copies only RecallHubTray.exe -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
  </ItemGroup>

  <!-- The WebView2 package references its WPF assembly unconditionally. In 1.0.4258.31 (unlike 1.0.2792.45) that assembly
       depends on WindowsBase 5.0, which conflicts with the WinForms-only reference set (MSB3277).
       This app has no WPF, so drop that reference before assembly resolution. -->
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="..\assets\icon.ico" Link="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Tenant icon picked by Branding.LoadIcon() when config.json says tenant=quellex -->
    <Content Include="..\assets\quellex.ico" Link="quellex.ico" Condition="Exists('..\assets\quellex.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
