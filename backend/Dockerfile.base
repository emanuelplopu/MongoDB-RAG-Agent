# RecallHub Backend - Pre-built Base Image
# ==========================================
# Contains all heavy dependencies that rarely change:
# - PyTorch, Transformers, Whisper, Docling (~8GB)
# - Playwright + Chromium browser (~400MB)
# - Docling models: layout, TableFormer, RapidOCR (~0.8GB, see below)
# - Whisper model(s) for audio/video transcription (turbo, 1.6GB, see below)
# - API dependencies (FastAPI, etc.)
#
# Build this image ONCE and reuse it:
#   docker build -f backend/Dockerfile.base -t recallhub-backend-base:latest .
#
# Then use Dockerfile.fast for quick code-only rebuilds
#
# VERSION: Update this when changing dependencies
ARG BASE_VERSION=1.2.0

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create virtual environment
RUN python -m venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" \
    VIRTUAL_ENV="/app/.venv"

RUN pip install --upgrade pip

# ============================================
# Install ALL Python dependencies at once
# ============================================
COPY backend/requirements-ml-heavy.txt ./
COPY backend/requirements-api.txt ./

# Install ML dependencies (slowest)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-ml-heavy.txt

# Install API dependencies
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements-api.txt

# Install Playwright and browser
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install playwright && \
    python -m playwright install chromium --with-deps

# ============================================
# Runtime Image
# ============================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    VIRTUAL_ENV="/app/.venv"

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    antiword \
    # Tesseract 5 OCR engine + German/English language packs for Docling
    # (OCR_ENGINE=tesseract, OCR_LANGUAGES=deu,eng; see src/ingestion/ingest.py)
    tesseract-ocr \
    tesseract-ocr-deu \
    tesseract-ocr-eng \
    # Playwright runtime dependencies
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    libdbus-1-3 \
    libatspi2.0-0 \
    libx11-xcb1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Copy virtual environment and playwright from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /root/.cache/ms-playwright /root/.cache/ms-playwright

# ============================================
# Docling models (baked in, no runtime download)
# ============================================
# Docling fetches its models from huggingface.co the first time a scanned
# page is converted. Without this layer every recreated backend / worker
# container downloads ~0.5 GB again (and fails without internet, which breaks
# the offline installer). DOCLING_ARTIFACTS_PATH makes docling load the
# models from here instead of its cache. The layer is ~0.8 GB (layout heron
# in safetensors + ONNX form, TableFormer, PP-OCRv6 small ONNX + torch). The
# set matches what the ingestion pipeline enables (layout, tables, OCR); enabling other
# docling enrichments (code/formula, picture classification, VLM) requires
# adding their models here too, because docling does NOT fall back to a
# download when an artifacts path is set.
ENV DOCLING_ARTIFACTS_PATH=/opt/docling-models
RUN docling-tools models download -o /opt/docling-models layout tableformer rapidocr     && rm -rf /root/.cache/huggingface /opt/docling-models/.cache

# Whisper checkpoint(s) for audio/video transcription (src/ingestion/ingest.py,
# MediaConfig). Docling's ASR pipeline calls whisper.load_model(name,
# download_root=DOCLING_ARTIFACTS_PATH), so the checkpoint must sit directly in
# the artifacts directory under openai-whisper's own file name (turbo =
# large-v3-turbo.pt). Without this layer every conversion worker downloaded the
# 1.6 GB at its first recording (an hour of stalled slots on a throttled uplink,
# 2026-11-06); the pipeline now records a missing model as an error instead of
# downloading. Bake other sizes the media config may select with
#   --build-arg WHISPER_MODELS="turbo small"
# (names from whisper._MODELS: tiny, base, small, medium, large, turbo, ...).
ARG WHISPER_MODELS="turbo"
RUN python -c "import os, whisper; root = os.environ['DOCLING_ARTIFACTS_PATH']; [whisper._download(whisper._MODELS[name], root, False) for name in '${WHISPER_MODELS}'.split()]" \
    && ls -la /opt/docling-models/*.pt

# Create app directories
RUN mkdir -p /app/projects /app/data /app/documents /app/src /app/backend

# Label for version tracking
ARG BASE_VERSION=1.2.0
LABEL recallhub.base.version="${BASE_VERSION}" \
      recallhub.base.description="Pre-built base image with ML deps + Playwright"

# Default command (will be overridden)
CMD ["python", "--version"]
