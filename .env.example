# RecallHub Configuration

# ============================================
# Tenant/Branding Configuration
# ============================================
TENANT_ID=recallhub
VITE_TENANT=recallhub
# Comma-separated TaskType values to disable for this tenant (e.g. web_search,browse_web)
# TENANT_DISABLED_TOOLS=

# Per-tenant profile/database pins used by docker-compose.yml (defaults shown).
# RECALLHUB_ACTIVE_PROFILE=parhelion
# RECALLHUB_MONGODB_DATABASE=rag_db
# QUELLEX_ACTIVE_PROFILE=diejuristin
# QUELLEX_MONGODB_DATABASE=rag_diejuristin

# For local Docker deployment: mongodb://mongodb:27017/?directConnection=true
# For MongoDB Atlas cloud: mongodb+srv://username:password@cluster.mongodb.net/?appName=RecallHub
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=RecallHub
MONGODB_DATABASE=rag_db
MONGODB_COLLECTION_DOCUMENTS=documents
MONGODB_COLLECTION_CHUNKS=chunks

# MongoDB Atlas Search Indexes
# These index names must match what you create in the Atlas UI
MONGODB_VECTOR_INDEX=vector_index
MONGODB_TEXT_INDEX=text_index

# Profile Configuration
# Active profile (overrides profiles.yaml setting)
# ACTIVE_PROFILE=default
# Path to profiles configuration file
# PROFILES_PATH=profiles.yaml

# LLM Provider Configuration
# Options: openai, openrouter, ollama, gemini
LLM_PROVIDER=openrouter
LLM_API_KEY=your-api-key-here
LLM_MODEL=anthropic/claude-haiku-4.5
LLM_BASE_URL=https://openrouter.ai/api/v1

# For local Ollama:
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1

# Embedding Provider Configuration
# Options: openai, google, voyageai, ollama
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your-openai-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSION=1536

# For local Ollama embeddings:
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_DIMENSION=768

# For the local llama.cpp embedding server (compose profile `embedder` on CPU or
# `embedder-gpu` on NVIDIA; OpenAI-compatible API, default model EmbeddingGemma 2):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=none
# EMBEDDING_MODEL=embeddinggemma-2
# EMBEDDING_BASE_URL=http://embedder:8080/v1      # http://localhost:11090/v1 from the host
# EMBEDDING_DIMENSION=768
# NOTE: EmbeddingGemma expects task prefixes ("task: search result | query: " /
# "title: none | text: "). The query path adds the query prefix automatically for
# known model families (EmbeddingGemma, nomic, e5, bge); documents are embedded
# without a prefix. EMBEDDING_QUERY_PREFIX overrides the query prefix (set it
# empty to disable). The benchmark/checks apply both prefixes.
# EMBEDDING_QUERY_PREFIX=

# llama.cpp embedding server settings (used by the `embedder*` compose services)
EMBEDDER_HF_MODEL=ggml-org/embeddinggemma-2-GGUF:Q8_0
EMBEDDER_CTX=32768          # total context, split across EMBEDDER_SLOTS (8192 per slot)
EMBEDDER_SLOTS=4
EMBEDDER_THREADS=8          # CPU threads (embedder profile only)
EMBEDDER_GPU_LAYERS=999     # layers offloaded to the GPU (embedder-gpu profile only)
EMBEDDER_BASE_URL=http://embedder:8080

# ============================================
# OCR for scanned pages (Docling; docs/24-OCR_SCAN_QUALITY_CHECK.md)
# ============================================
# Engine used by the ingestion worker for scanned PDFs and image files:
#   tesseract  Tesseract 5 CLI with the deu/eng packs baked into the base image
#              (default; 0.99 word recall on the synthetic law-firm scans)
#   rapidocr   Docling's bundled RapidOCR (0.84 word recall, letter soup on
#              whole lines, glued tokens; what "auto" picked before)
#   easyocr    needs the easyocr package in the image (not installed by default)
#   auto       let Docling pick (OcrAutoOptions, languages ignored)
# Changing the engine only affects documents ingested afterwards; already
# ingested scans keep their old OCR text until they are re-ingested.
# OCR_ENGINE=tesseract
# Comma-separated ISO 639-2 language codes (tesseract needs the matching
# tesseract-ocr-<lang> package; easyocr codes are derived automatically).
# OCR_LANGUAGES=deu,eng
# Resolution at which PDF pages are rasterised for the OCR engine (dpi).
# 216 = Docling's default (scale 3.0).
# OCR_SCAN_DPI=216
# Megapixel budget of the OCR bitmap for image files (JPG/PNG/TIF). Docling
# OCRs images at 3x their size in points, i.e. a phone photo without a DPI tag
# at 3x its pixel size (~140 Mpx for a 12 Mpx photo, 20-60 s each). The 3x
# scale is kept unless the bitmap would exceed the budget (8 Mpx = a 3:4 photo at
# ~2,450 x 3,270 px, A4 at 300 dpi; measured: same text as 20 Mpx, half the time); A4 scan images
# (4.5 Mpx at 3x) are not affected. 0 = no cap.
# OCR_IMAGE_MAX_MPX=8
# Tesseract page segmentation mode per OCR rectangle (0-13); empty = default (3).
# OCR_PSM=
# Directory with alternative traineddata files (e.g. tessdata_best); empty = the
# deu/eng packs of the image.
# OCR_TESSDATA_PATH=
# Minimum orientation-detection confidence before an OCR rectangle is rotated
# outright; below it the rotation is verified by OCRing the rectangle both ways
# and keeping the better reading. 0 = rotate on any detected orientation
# (Docling's behaviour, which flips upright Courier pages and tables by 180°).
# OCR_OSD_MIN_CONFIDENCE=10
# Keep page headers and footers (Docling's "furniture" layer) in the stored
# content and the chunks. Docling drops them by default, which loses the
# Geschäftszahl header of court documents, ERV delivery stamps and the bank
# details in letter footers. Applies to all document formats, not only scans.
# INGEST_PAGE_FURNITURE=false
# Run Docling's table-structure stage (TableFormer). On, detected tables become
# Markdown tables but the OCR cells TableFormer cannot place are dropped (dates
# and amounts of OCRed Honorarnote / Grundbuch tables); off keeps every table
# line as plain text, row by row.
# INGEST_TABLE_STRUCTURE=true
# Dilation (page points) of the layout clusters before neighbouring ones are
# merged into one OCR rectangle. Docling's 20 merges stacked tables (gaps of
# ~24 pt) into one crop, on which Tesseract drops whole columns of dates and
# amounts; a small value keeps them separate.
# OCR_RECT_DILATION=20
# Store no text for image files whose OCR output is letter soup (photos of
# cars, rooms, building sites); photographed letters, forms and screenshots
# still pass (word-like token ratio and Docling OCR confidence).
# OCR_IMAGE_NOISE_GATE=false
# Image-only PDFs (pure scans, no text layer; ~30% of the PDFs of a law-firm NAS) are
# OCRed like any other PDF. Set true to skip them before OCR in the worker's concurrent
# loop (max_concurrent_files > 1), e.g. for a text-only profile where a scan can only
# cost OCR time. They are then recorded as classification "image_only_pdf" with no
# content. The sequential loop (max_concurrent_files = 1) never skipped them.
# INGEST_SKIP_IMAGE_ONLY_PDF=false
# Extract text from email (.msg/.eml) attachments (PDF via OCR, .doc via antiword,
# .docx via Docling, images via OCR) and append it to the stored email content.
# Off (default) lists attachment filenames only. In a law-firm corpus ~30% of
# emails carry the substantive document as an attachment, so turn this on for such
# corpora. Noise (signatures, winmail.dat, tiny inline logos) is skipped; each
# attachment adds OCR/conversion cost. See docs/26-FORMAT_EDGE_AUDIT.md.
# MSG_EXTRACT_ATTACHMENTS=false
# MSG_ATTACHMENT_MAX_MB=25
# MSG_ATTACHMENT_MAX_COUNT=20
# Throughput (docs/04-EMBEDDING_AND_QUERY_SYSTEM.md, "Parallel conversions"). Every
# run converts on one shared thread pool sized from the Configuration page's
# "Thread Pool Workers" / "Concurrent Files" (the pool is never smaller than the
# file concurrency). INGEST_THREAD_POOL_WORKERS is the pool size for runs that
# pass none (CLI). The CPU threads per Docling model and per Tesseract process are
# shared evenly across the pool (1-4) unless pinned here; OCR_OMP_THREAD_LIMIT=0
# leaves Tesseract's OpenMP threads free (fine for 1-2 parallel conversions, it
# collapses throughput beyond ~8).
# INGEST_THREAD_POOL_WORKERS=4
# INGEST_DOCLING_THREADS=
# OCR_OMP_THREAD_LIMIT=

# ============================================
# Provider-Specific API Keys (for embedding benchmark & multi-provider support)
# ============================================

# OpenAI API Key (also used for embeddings if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini API Key (for gemini-embedding-2-preview, gemini-embedding-001)
# Get your key at: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-google-api-key-here

# Voyage AI API Key (for voyage-4-large, voyage-4, voyage-4-lite)
# Get your key at: https://www.voyageai.com/
# VOYAGE_API_KEY=your-voyage-api-key-here

# Anthropic API Key (for Claude models - LLM only, no embeddings)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Search Configuration
DEFAULT_MATCH_COUNT=10
MAX_MATCH_COUNT=50
DEFAULT_TEXT_WEIGHT=0.3

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# ============================================
# Security Settings (IMPORTANT FOR PRODUCTION)
# ============================================

# JWT Secret Key - CRITICAL: Change this in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters for production
JWT_SECRET_KEY=recallhub-secret-key-change-in-production

# Registration Control
# REGISTRATION_MODE options:
#   - "open" (default): Anyone can register
#   - "invite": Requires invite code
#   - "closed": No public registration (admin creates users)
REGISTRATION_MODE=open

# Invite codes (for REGISTRATION_MODE=invite)
# Single code:
# INVITE_CODE=your-secret-invite-code
# Multiple codes (comma-separated):
# INVITE_CODES=code1,code2,code3

# API Documentation Exposure
# Set to "false" in production to hide /docs, /redoc, /openapi.json
# EXPOSE_API_DOCS=true

# Login enforcement (backend/core/auth_middleware.py)
# When true, every API request except health, tenant config, login and
# register must carry a valid session (JWT) or API key; guests get 401.
# docker-compose.yml sets REQUIRE_AUTH per tenant from these two values:
# QUELLEX_REQUIRE_AUTH=true
# RECALLHUB_REQUIRE_AUTH=false
# (REQUIRE_AUTH itself is read when the backend runs outside Compose.)
# REQUIRE_AUTH=false

# ============================================
# Network exposure (docker-compose.yml)
# ============================================

# Address the raw service ports (11000/11001 API, 11080/11081 frontend,
# 11017 MongoDB, 11090 embedder) bind to on the host. The default keeps them
# reachable from this machine only; other computers use the TLS gateway below.
# Set 0.0.0.0 to expose them on every interface (e.g. Tailscale to a dev box).
# BIND_ADDRESS=127.0.0.1

# LAN gateway (Caddy, profile quellex / recallhub): the HTTPS edge other
# computers connect to. The tray app announces the names via mDNS/LLMNR.
# QUELLEX_GATEWAY_HTTPS_PORT=443
# QUELLEX_GATEWAY_HTTP_PORT=80
# QUELLEX_GATEWAY_HOSTS=https://quellex.local, https://quellex
# Clients on another office subnet cannot use mDNS: add a name the office DNS
# serves (e.g. https://quellex.<dhcp-domain>) and a record for it (docs/21).
# RECALLHUB_GATEWAY_HTTPS_PORT=11443
# RECALLHUB_GATEWAY_HTTP_PORT=11480
# RECALLHUB_GATEWAY_HOSTS=https://recallhub.local, https://recallhub

# ============================================
# Document folders and network shares (docs/22-DOCUMENT_FOLDERS_AND_SHARES.md)
# ============================================
# Every sub-folder of ./mounts is visible to the API and the ingestion worker
# as /app/mounts/<name>. Network shares (SMB/CIFS) are attached below
# /app/mounts by docker-compose.shares.yml, written by
# installer/scripts/Add-NetworkShare.ps1. Organisation admins may only pick
# profile folders below these roots (container paths, comma separated).
# DOCUMENT_ROOTS=/app/mounts,/app/documents
# Path whose filesystem usage the superadmin host-stats widget reports
# (GET /api/v1/system/host-stats, docs/12-TELEMETRY_SYSTEM.md). As seen inside
# the API container. Empty = auto-detect: first existing DOCUMENT_ROOTS entry,
# else the container root.
# HOST_STATS_DISK_PATH=
# Host telemetry history (docs/12-TELEMETRY_SYSTEM.md): activity events from the API/worker and
# samples from the Windows host agent (installer/scripts/Install-HostAgent.ps1), stored in their own
# database. The agent's Agent:Database must match TELEMETRY_DATABASE.
# TELEMETRY_HISTORY_ENABLED=true
# TELEMETRY_DATABASE=recallhub_telemetry
# HOST_SAMPLES_TTL_DAYS=30
# ACTIVITY_EVENTS_TTL_DAYS=90
# HOST_AGENT_STALE_SECONDS=20
# MongoDB statistics sampled into db_samples (counts, sizes, embedding coverage, search-index
# state, connections, oplog) every DB_STATS_INTERVAL_MINUTES by whichever API/worker process
# takes the slot's lease; shown on System -> Telemetry and in the machine-stats widget.
# DB_STATS_ENABLED=true
# DB_STATS_INTERVAL_MINUTES=30
# DB_STATS_TTL_DAYS=400
# API and worker refresh their activity_current document this often while idle (liveness).
# PROCESS_HEARTBEAT_SECONDS=30
# Extra compose file(s) for plain "docker compose up -d"; the installer scripts
# and the tray app add docker-compose.shares.yml on their own when it exists.
# Separator is ";" on Windows (COMPOSE_PATH_SEPARATOR), ":" elsewhere.
# COMPOSE_FILE=docker-compose.yml;docker-compose.override.yml;docker-compose.shares.yml
# container_path=host_path pairs, "|" separated, so "Open in Explorer" on the
# Documents page can show the Windows or UNC path of an indexed file.
# MOUNT_MAPPINGS=/app/mounts/kanzlei=\\nas\Kanzlei|/app/mounts/archiv=D:\Archiv
# Credentials of a share (one pair per share, referenced from
# docker-compose.shares.yml). Never commit a filled-in .env.
# SHARE_KANZLEI_USER=svc-recallhub
# SHARE_KANZLEI_PASSWORD=

# ============================================
# Airbyte Integration (for Confluence, Jira, and other complex APIs)
# ============================================
# To enable Airbyte, run: docker-compose -f docker-compose.yml -f docker-compose.airbyte.yml up -d
AIRBYTE_ENABLED=false
AIRBYTE_API_URL=http://airbyte-server:8001
AIRBYTE_WEBAPP_URL=http://localhost:11020

# Cloud Source Provider Credentials (optional)
# Google Drive - OAuth 2.0 (configure in UI)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Dropbox - OAuth 2.0 (configure in UI)
# DROPBOX_CLIENT_ID=your-dropbox-app-key
# DROPBOX_CLIENT_SECRET=your-dropbox-app-secret

# Atlassian (Confluence/Jira) - via Airbyte
# ATLASSIAN_DOMAIN=your-domain.atlassian.net
# ATLASSIAN_EMAIL=your-email@example.com
# ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Cloudflare Tunnel Configuration (for public access)
# Create API Token at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions:
#   - Account > Cloudflare Tunnel > Edit
#   - Zone > DNS > Edit (for your domain)
#   - Zone > Zone > Read
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
#
# Alternatively, use a tunnel-specific token (from Cloudflare dashboard):
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# ============================================
# Docker BuildKit Configuration
# ============================================
# Required for layer caching optimizations in Dockerfile.ml-heavy
# These enable faster incremental builds by caching pip downloads
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ============================================
# Telemetry
# ============================================
# Captures full interaction traces for data-driven development
TELEMETRY_ENABLED=true
TELEMETRY_MODE=dev
# PII modes: both (protected + raw), protected_only, raw_only, disabled
TELEMETRY_PII_MODE=both
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_STORAGE_PATH=data/telemetry
